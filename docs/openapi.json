{
  "openapi": "3.1.0",
  "info": {
    "title": "OPEN-NPU — API de calcul",
    "version": "1.0.0"
  },
  "security": [
    {
      "projectKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "projectKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "JobId": {
        "in": "path",
        "name": "job_id",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    }
  },
  "paths": {
    "/v1/jobs": {
      "post": {
        "summary": "Soumettre un calcul de démonstration",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._~-]{8,128}$"
            },
            "description": "Conserver la même clé pour rejouer la même demande."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "capsule",
                  "values"
                ],
                "properties": {
                  "capsule": {
                    "const": "square-fp16-v1"
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4096,
                    "items": {
                      "type": "number",
                      "minimum": -200,
                      "maximum": 200
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Demande acceptée avec son identifiant.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{32}$"
                    },
                    "status": {
                      "const": "queued"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "description": "Présent lors du rejeu d’une demande connue.",
                "schema": {
                  "const": "true"
                }
              }
            }
          },
          "400": {
            "description": "Entrée invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Clé de projet invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "La clé est en lecture seule.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Admission suspendue ou clé d’idempotence réutilisée pour un contenu différent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Corps de requête trop volumineux."
          },
          "415": {
            "description": "Type de contenu incorrect. Envoyer du JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Quota atteint. Consulter Retry-After.",
            "headers": {
              "Retry-After": {
                "description": "Délai d’attente en secondes.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "get": {
        "summary": "Consulter le statut et les résultats",
        "responses": {
          "200": {
            "description": "État queued, running, done, failed ou cancelled. En cas de succès, values contient les résultats ordonnés.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{32}$"
                        },
                        "status": {
                          "const": "done"
                        },
                        "values": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "status",
                        "values"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{32}$"
                        },
                        "status": {
                          "enum": [
                            "queued",
                            "running",
                            "failed",
                            "cancelled"
                          ]
                        },
                        "completed": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "id",
                        "status",
                        "completed",
                        "total"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Clé de projet invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Demande introuvable pour ce projet.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "post": {
        "summary": "Annuler une demande active",
        "responses": {
          "200": {
            "description": "Demande annulée.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{32}$"
                    },
                    "status": {
                      "const": "cancelled"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Clé de projet invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "La clé est en lecture seule.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Demande introuvable pour ce projet.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Demande déjà terminée ou en échec.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v2/capsules": {
      "get": {
        "summary": "Lister les capsules signées approuvées",
        "responses": {
          "200": {
            "description": "Versions et contrats de tenseurs."
          }
        }
      }
    },
    "/v2/jobs": {
      "post": {
        "summary": "Soumettre un calcul par étapes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "capsule",
                  "version"
                ],
                "properties": {
                  "capsule": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "distinct_nodes": {
                    "type": "boolean",
                    "default": true
                  },
                  "verify_results": {
                    "type": "boolean",
                    "default": false,
                    "description": "Faire recalculer chaque étape par un second nœud et comparer les sorties."
                  },
                  "tokens": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "max_new_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "tokens",
                      "max_new_tokens"
                    ]
                  },
                  {
                    "required": [
                      "values"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Demande acceptée."
          },
          "400": {
            "description": "Entrée hors contrat."
          },
          "404": {
            "description": "Capsule non approuvée ou inconnue."
          },
          "429": {
            "description": "Quota de projet atteint."
          }
        }
      }
    },
    "/v2/jobs/{job_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "get": {
        "summary": "Suivre les étapes et récupérer les tokens générés",
        "responses": {
          "200": {
            "description": "État, étage et tour (indices à partir de zéro), tokens, éventuelle erreur et nombre de nœuds affectés."
          },
          "404": {
            "description": "Demande inconnue pour ce projet."
          }
        }
      }
    },
    "/v2/jobs/{job_id}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "post": {
        "summary": "Annuler une demande en attente ou en cours",
        "responses": {
          "200": { "description": "Demande annulée, y compris si elle l’était déjà." },
          "404": { "description": "Demande inconnue pour ce projet." },
          "409": { "description": "Demande déjà terminée ou en échec." }
        }
      }
    },
    "/v2/jobs/{job_id}/result": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "get": {
        "summary": "Télécharger la sortie binaire d’une capsule tensor",
        "responses": {
          "200": {
            "description": "Tenseur little-endian.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Résultat binaire indisponible."
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Même origine que cette documentation."
    }
  ]
}
